# ─────────────────────────────────────────────────────────────────────────────
# Sokratic-OT — environment variables
# Copy this file to `.env` and fill in real values. The repo's .gitignore
# excludes `.env*`, so secrets stay local.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── Single credentials file ─────────────────────────────────────────────────
# Keep every runtime/deployment secret in this .env file only. Do not paste
# credentials into systemd units, Nginx configs, docs, shell history, or code.

# ─── Optional: GCP deployment coordinates ────────────────────────────────────
# The app itself does not need a GCP service-account key when it runs on a VM.
# Use the VM's attached service account / console / gcloud for infrastructure.
# If you do use a local service-account file for admin commands, do not commit
# it; point to it from this file only.
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
# GOOGLE_APPLICATION_CREDENTIALS=/opt/sokratic/secrets/gcp-service-account.json

# ─── Required: LLM providers ─────────────────────────────────────────────────
# Anthropic — used by teacher (Haiku), dean (Haiku), evaluator (Haiku),
# and vision flow (Sonnet). Get one at https://console.anthropic.com/.
# NOTE: As of 2026-05-01 the runtime defaults to AWS Bedrock (see below).
# Direct Anthropic is the fallback when SOKRATIC_USE_BEDROCK is unset/0.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — used ONLY for embeddings (text-embedding-3-large) when (re)building
# the Qdrant index from chunks. Not used at runtime if the index already
# exists. Get one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-...

# ─── Required (current runtime): AWS Bedrock ─────────────────────────────────
# Sonnet 4.6 + Haiku 4.5 are served via AWS Bedrock cross-region inference
# profiles in us-east-1. Model access must be enabled in the AWS console
# (Bedrock → Model access) for the IAM user whose keys are below.
# When SOKRATIC_USE_BEDROCK=1, conversation/llm_client.py uses
# AnthropicBedrock(); when 0/unset, it falls back to direct Anthropic.
SOKRATIC_USE_BEDROCK=1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# ─── Required: domain selection ──────────────────────────────────────────────
# Selects which `config/domains/<domain>.yaml` to merge into config/base.yaml.
# Valid: "ot" (anatomy — default), "physics" (legacy/experimental).
SOKRATIC_DOMAIN=ot

# ─── Required for data pull from HuggingFace ─────────────────────────────────
# Used by `scripts/bootstrap_corpus.py` to download every deployable data
# artifact listed in data/MANIFEST.json. Do not rebuild or manually copy data
# on the GCP VM; publish/pull artifacts through HuggingFace.
# HF_TOKEN is only needed if the dataset repo is private — for the public
# `arun-ghontale/sokratic-anatomy-corpus` repo it can be left blank.
# HF_USERNAME defaults the repo owner; override if you've forked the dataset.
HF_USERNAME=arun-ghontale
HF_TOKEN=

# ─── Optional: LangSmith tracing (free tier, 5000 traces/month) ──────────────
# Sign up at https://smith.langchain.com — LangGraph picks this up
# automatically once the keys are present (zero code changes).
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=sokratic-ot

# ─── Optional: Qdrant connection ─────────────────────────────────────────────
# Defaults match `scripts/qdrant_up.sh` (Docker-on-localhost). Override only
# if you're pointing at a remote Qdrant cluster.
# QDRANT_HOST=localhost
# QDRANT_HTTP_PORT=6333
# QDRANT_GRPC_PORT=6334
# QDRANT_DATA_DIR=./.qdrant_data

# ─── Optional: frontend → backend wiring ─────────────────────────────────────
# Read by Vite at build time. Default is fine for `pnpm dev` on the same host.
# Override when the FastAPI backend is on a different origin.
# VITE_API_BASE=http://localhost:8000
# SOKRATIC_CORS_ORIGINS=https://YOUR_DOMAIN

# ─── Required for public demo deployment: basic login ───────────────────────
# Three password-protected demo profiles. Use real shared passwords on the VM.
# Format: username:password pairs separated by commas.
SOKRATIC_AUTH_USERS=arun:change-me-arun,nidhi:change-me-nidhi,grader:change-me-grader
# Random token signing secret. Generate with:
#   openssl rand -hex 32
SOKRATIC_AUTH_SECRET=change-me-random-token-secret

# ─── Optional: HuggingFace cache (offline mode) ──────────────────────────────
# When set, the cross-encoder won't try to redownload the model. Useful in
# CI / air-gapped runs. The model lives in ~/.cache/huggingface by default.
# TRANSFORMERS_OFFLINE=1
# HF_HOME=~/.cache/huggingface
